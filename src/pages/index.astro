		/* ── RESPONSIVE ── */
		@media (max-width: 900px) {
			.nav-links, .desktop-cta { display: none; }
			.hamburger { display: flex; }
		}

		@media (max-width: 768px) {
			.hero { padding: 8rem 5vw 4rem; }
