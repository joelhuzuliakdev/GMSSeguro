	<style>
		:root {
			--bg: #060a10;
			--surface: #999999; 0a0f18
			--card: #0d1520;
			--accent: #1a6bbd;       /* azul logo GMS */
			--accent-light: #2d8de8; /* azul más brillante para hovers */
			--accent2: #0000FF;      /* celeste complementario */
			--text: #e8edf5;
			--muted: #6b7a90;
			--border: rgba(255,255,255,0.06);
			--border-accent: rgba(26,107,189,0.3);
		}

		*, *::before, *::after {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		html { scroll-behavior: smooth; }

		body {
			font-family: 'DM Sans', sans-serif;
			background: var(--bg);
			color: var(--text);
			overflow-x: hidden;
		}

		/* ── NAV ── */
		nav {
			position: fixed;
			top: 0; left: 0; right: 0;
			z-index: 100;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.9rem 5vw;
			backdrop-filter: blur(18px);
			background: rgba(6,10,16,0.85);
			border-bottom: 1px solid var(--border);
		}

		.logo {
			display: flex;
			align-items: center;
			text-decoration: none;
		}

		.logo-img {
			height: 52px;
			width: auto;
			object-fit: contain;
			/* logo tiene fondo blanco, le damos padding y border-radius sutil */
			background: #fff;
			border-radius: 8px;
			padding: 3px 6px;
		}

		.nav-links {
			display: flex;
			gap: 2rem;
			list-style: none;
		}
		.nav-links a {
			color: var(--muted);
			text-decoration: none;
			font-size: 0.9rem;
			letter-spacing: 0.05em;
			transition: color 0.2s;
		}
		.nav-links a:hover { color: var(--accent-light); }

		.nav-cta {
			background: var(--accent);
			color: #fff;
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 0.85rem;
			letter-spacing: 0.06em;
			padding: 0.6rem 1.4rem;
			border-radius: 4px;
			text-decoration: none;
			transition: background 0.2s, transform 0.2s;
		}
		.nav-cta:hover {
			background: var(--accent-light);
			transform: translateY(-1px);
		}

		/* ── HAMBURGER ── */
		.hamburger {
			display: none;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			background: none;
			border: none;
			cursor: pointer;
			padding: 6px;
			z-index: 101;
		}
		.hamburger span {
			display: block;
			width: 26px;
			height: 2px;
			background: var(--text);
			border-radius: 2px;
			transition: transform 0.3s, opacity 0.3s;
		}
		.hamburger.active span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}
		.hamburger.active span:nth-child(2) {
			opacity: 0;
		}
		.hamburger.active span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}

		/* ── MOBILE MENU ── */
		.mobile-menu {
			position: fixed;
			top: 0; right: -100%;
			width: min(320px, 85vw);
			height: 100vh;
			background: #0a0f18;
			border-left: 1px solid var(--border-accent);
			z-index: 99;
			display: flex;
			flex-direction: column;
			padding: 6rem 2rem 2rem;
			gap: 2rem;
			transition: right 0.35s cubic-bezier(0.4,0,0.2,1);
		}
		.mobile-menu.open {
			right: 0;
		}
		.mobile-menu ul {
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 0;
		}
		.mobile-menu ul li a {
			display: block;
			color: var(--text);
			text-decoration: none;
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 1.3rem;
			padding: 1rem 0;
			border-bottom: 1px solid var(--border);
			transition: color 0.2s, padding-left 0.2s;
		}
		.mobile-menu ul li a:hover {
			color: var(--accent-light);
			padding-left: 0.5rem;
		}
		.mobile-menu-cta {
			margin-top: auto;
			text-align: center;
		}

		.mobile-overlay {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(0,0,0,0.6);
			backdrop-filter: blur(3px);
			z-index: 98;
		}
		.mobile-overlay.show { display: block; }

		/* ── HERO ── */
		.hero {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 10rem 5vw 6rem;
			position: relative;
			overflow: hidden;
		}

		.hero-bg {
			position: absolute;
			inset: 0;
			z-index: 0;
			background:
				radial-gradient(ellipse 60% 50% at 70% 50%, rgba(26,107,189,0.12) 0%, transparent 70%),
				radial-gradient(ellipse 40% 60% at 10% 80%, rgba(45,142,232,0.07) 0%, transparent 60%);
		}
		.hero-bg::before {
			content: '';
			position: absolute;
			inset: 0;
			background-image:
				linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
				linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
			background-size: 60px 60px;
		}

		.hero h1 {
			font-family: 'Syne', sans-serif;
			font-size: clamp(2.8rem, 7vw, 6rem);
			font-weight: 800;
			line-height: 1.0;
			max-width: 12ch;
			position: relative;
			z-index: 1;
		}
		.hero h1 em {
			font-style: normal;
			background: linear-gradient(135deg, var(--accent-light), var(--accent2));
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.hero-sub {
			margin-top: 1.8rem;
			font-size: 1.15rem;
			color: var(--muted);
			line-height: 1.7;
			max-width: 45ch;
			position: relative;
			z-index: 1;
		}

		.hero-actions {
			display: flex;
			gap: 1rem;
			margin-top: 2.5rem;
			flex-wrap: wrap;
			position: relative;
			z-index: 1;
		}

		.btn-primary {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			background: var(--accent);
			color: #fff;
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 0.95rem;
			padding: 0.9rem 2rem;
			border-radius: 6px;
			text-decoration: none;
			transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
			box-shadow: 0 0 30px rgba(26,107,189,0.3);
		}
		.btn-primary:hover {
			transform: translateY(-2px);
			background: var(--accent-light);
			box-shadow: 0 0 45px rgba(45,142,232,0.45);
		}

		.btn-ghost {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			border: 1px solid var(--border);
			color: var(--text);
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 0.95rem;
			padding: 0.9rem 2rem;
			border-radius: 6px;
			text-decoration: none;
			transition: border-color 0.2s, background 0.2s;
		}
		.btn-ghost:hover {
			border-color: var(--accent-light);
			background: rgba(26,107,189,0.08);
		}

		.hero-stats {
			display: flex;
			gap: 3rem;
			margin-top: 5rem;
			position: relative;
			z-index: 1;
			padding-top: 3rem;
			border-top: 1px solid var(--border);
			flex-wrap: wrap;
		}
		.stat-num {
			font-family: 'Syne', sans-serif;
			font-size: 2.2rem;
			font-weight: 800;
			color: var(--accent2);
		}
		.stat-label {
			font-size: 0.82rem;
			color: var(--muted);
			margin-top: 0.2rem;
			letter-spacing: 0.04em;
		}

		/* ── ABOUT ── */
		#nosotros { background: var(--surface); }

		.about-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 5rem;
			align-items: center;
		}

		.about-desc {
			color: var(--muted);
			font-size: 0.97rem;
			line-height: 1.75;
			margin-bottom: 1.2rem;
			max-width: 48ch;
		}

		.about-values {
			display: flex;
			flex-direction: column;
			gap: 1.2rem;
			margin-top: 2.2rem;
		}
		.about-value {
			display: flex;
			align-items: flex-start;
			gap: 1rem;
			padding: 1.2rem 1.4rem;
			background: var(--card);
			border: 1px solid var(--border);
			border-radius: 10px;
			transition: border-color 0.3s;
		}
		.about-value:hover { border-color: var(--border-accent); }
		.value-icon { font-size: 1.4rem; flex-shrink: 0; margin-top: 0.1rem; }
		.about-value strong {
			display: block;
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 0.95rem;
			margin-bottom: 0.25rem;
		}
		.about-value p { font-size: 0.84rem; color: var(--muted); line-height: 1.5; }

		.about-visual {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 420px;
		}
		.about-bg-glow {
			position: absolute;
			width: 320px; height: 320px;
			border-radius: 50%;
			background: radial-gradient(circle, rgba(26,107,189,0.08) 0%, transparent 70%);
			pointer-events: none;
		}
		.about-card-main {
			background: var(--card);
			border: 1px solid var(--border-accent);
			border-radius: 16px;
			padding: 2.5rem 2rem;
			text-align: center;
			position: relative;
			z-index: 1;
			min-width: 220px;
		}
		.about-card-icon { font-size: 3rem; margin-bottom: 1rem; }
		.about-card-label {
			font-family: 'Syne', sans-serif;
			font-weight: 800;
			font-size: 1.1rem;
			margin-bottom: 0.3rem;
		}
		.about-card-sub {
			font-size: 0.82rem;
			color: var(--accent-light);
			letter-spacing: 0.06em;
		}

		.about-pill {
			position: absolute;
			background: var(--card);
			border: 1px solid var(--border);
			border-radius: 100px;
			padding: 0.5rem 1.1rem;
			font-size: 0.8rem;
			color: var(--text);
			display: flex;
			align-items: center;
			gap: 0.5rem;
			white-space: nowrap;
			z-index: 2;
			backdrop-filter: blur(8px);
		}
		.pill-dot {
			width: 7px; height: 7px;
			border-radius: 50%;
			background: var(--accent-light);
			flex-shrink: 0;
		}
		.pill-1 { top: 10%; right: -5%; }
		.pill-2 { bottom: 20%; right: -8%; }
		.pill-3 { top: 65%; left: -8%; }

		/* ── SECTIONS SHARED ── */
		section { padding: 6rem 5vw; }

		.section-tag {
			display: inline-block;
			font-size: 0.75rem;
			font-weight: 500;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: var(--accent-light);
			margin-bottom: 1rem;
		}
		.section-title {
			font-family: 'Syne', sans-serif;
			font-size: clamp(1.8rem, 4vw, 2.8rem);
			font-weight: 800;
			line-height: 1.1;
		}
		.section-sub {
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.7;
			max-width: 50ch;
			margin-top: 0.8rem;
		}

		/* ── SERVICES ── */
		#servicios { background: var(--surface); }

		.services-header { margin-bottom: 3.5rem; }

		.services-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1.5px;
			background: var(--border);
			border: 1px solid var(--border);
			border-radius: 12px;
			overflow: hidden;
		}
		.service-card {
			background: var(--card);
			padding: 2.4rem 2rem;
			position: relative;
			overflow: hidden;
			transition: background 0.3s;
			cursor: default;
		}
		.service-card::before {
			content: '';
			position: absolute;
			top: 0; left: 0; right: 0;
			height: 2px;
			background: linear-gradient(90deg, transparent, var(--accent-light), transparent);
			transform: scaleX(0);
			transition: transform 0.4s;
		}
		.service-card:hover { background: #10192a; }
		.service-card:hover::before { transform: scaleX(1); }

		.service-icon {
			width: 52px; height: 52px;
			background: rgba(26,107,189,0.1);
			border: 1px solid var(--border-accent);
			border-radius: 12px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.4rem;
			margin-bottom: 1.5rem;
		}
		.service-card h3 {
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 1.1rem;
			margin-bottom: 0.8rem;
		}
		.service-card p { font-size: 0.9rem; color: var(--muted); line-height: 1.65; }
		.service-num {
			position: absolute;
			top: 1.5rem; right: 1.8rem;
			font-family: 'Syne', sans-serif;
			font-size: 3rem;
			font-weight: 800;
			color: rgba(255,255,255,0.03);
			line-height: 1;
		}

		/* ── GALLERY ── */
		#galeria { background: var(--surface); }
		.gallery-header { margin-bottom: 3rem; }

		.gallery-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			grid-auto-rows: 220px;
			gap: 8px;
			border-radius: 12px;
			overflow: hidden;
		}
		.gallery-item {
			position: relative;
			overflow: hidden;
			cursor: pointer;
			background: var(--card);
		}
		.gallery-item.tall { grid-row: span 2; }
		.gallery-item.wide { grid-column: span 2; }
		.gallery-item img {
			width: 100%; height: 100%;
			object-fit: cover;
			transition: transform 0.5s ease, filter 0.4s ease;
			filter: brightness(0.85) saturate(0.9);
		}
		.gallery-item:hover img {
			transform: scale(1.06);
			filter: brightness(1) saturate(1.1);
		}
		.gallery-overlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(to top, rgba(6,10,16,0.85) 0%, transparent 50%);
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 1.2rem;
			opacity: 0;
			transition: opacity 0.35s ease;
		}
		.gallery-item:hover .gallery-overlay { opacity: 1; }
		.gallery-tag {
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
			background: rgba(26,107,189,0.2);
			border: 1px solid rgba(45,142,232,0.35);
			color: var(--accent2);
			font-size: 0.72rem;
			font-weight: 600;
			letter-spacing: 0.08em;
			padding: 0.25rem 0.7rem;
			border-radius: 100px;
			width: fit-content;
			margin-bottom: 0.5rem;
		}
		.gallery-overlay p {
			font-size: 0.88rem;
			color: var(--text);
			font-weight: 500;
			line-height: 1.3;
		}

		/* Lightbox */
		.lightbox {
			display: none;
			position: fixed;
			inset: 0;
			z-index: 500;
			background: rgba(5, 7, 9, 0.95);
			backdrop-filter: blur(12px);
			align-items: center;
			justify-content: center;
			flex-direction: column;
			gap: 1rem;
			padding: 2rem;
			cursor: zoom-out;
		}
		.lightbox.active { display: flex; }
		.lightbox img {
			max-width: 90vw;
			max-height: 80vh;
			object-fit: contain;
			border-radius: 8px;
			box-shadow: 0 0 80px rgba(0,0,0,0.8);
			animation: fadeIn 0.25s ease;
		}
		.lightbox p { color: var(--muted); font-size: 0.9rem; text-align: center; }
		.lightbox-close {
			position: absolute;
			top: 1.5rem; right: 2rem;
			background: var(--card);
			border: 1px solid var(--border);
			color: var(--text);
			font-size: 1.1rem;
			width: 42px; height: 42px;
			border-radius: 50%;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: border-color 0.2s, color 0.2s;
		}
		.lightbox-close:hover { border-color: var(--accent-light); color: var(--accent-light); }
		@keyframes fadeIn {
			from { opacity: 0; transform: scale(0.96); }
			to   { opacity: 1; transform: scale(1); }
		}


		/* ── APP SECTION ── */
		#app {
			background: var(--surface);
			overflow: hidden;
		}

		.app-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 5rem;
			align-items: center;
		}

		.app-desc {
			color: var(--muted);
			font-size: 0.97rem;
			line-height: 1.75;
			margin-bottom: 2rem;
		}
		.app-desc strong {
			color: var(--accent-light);
		}

		.app-features {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.app-feature {
			display: flex;
			align-items: flex-start;
			gap: 1rem;
			padding: 1rem 1.2rem;
			background: var(--card);
			border: 1px solid var(--border);
			border-radius: 10px;
			transition: border-color 0.3s;
		}
		.app-feature:hover {
			border-color: var(--border-accent);
		}
		.app-feature-icon {
			font-size: 1.3rem;
			flex-shrink: 0;
			margin-top: 0.1rem;
		}
		.app-feature strong {
			display: block;
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 0.9rem;
			margin-bottom: 0.2rem;
		}
		.app-feature p {
			font-size: 0.82rem;
			color: var(--muted);
			line-height: 1.5;
		}

		.app-badges {
			display: flex;
			gap: 1rem;
			margin-top: 2rem;
			flex-wrap: wrap;
		}
		.app-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			background: var(--card);
			border: 1px solid var(--border-accent);
			color: var(--text);
			font-family: 'Syne', sans-serif;
			font-weight: 700;
			font-size: 0.85rem;
			padding: 0.65rem 1.3rem;
			border-radius: 8px;
			cursor: default;
			transition: border-color 0.2s, background 0.2s;
		}
		.app-badge:hover {
			background: rgba(26,107,189,0.08);
			border-color: var(--accent-light);
		}

